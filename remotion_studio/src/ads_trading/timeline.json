 "segments": [
  {
   "id": "gancho",
   "text": "¿Meter plata en anuncios de dropshipping o arriesgarla en trading? ¡No elijas a ciegas!",
   "start": 0.0,
   "end": 3.65,
   "words": 14,
   "reconocidas": "84 % de letras"
  },
  {
   "id": "filtro",
   "text": "En treinta segundos te muestro qué exige cada uno para no quemar tu capital.",
   "start": 3.73,
   "end": 7.01,
   "words": 14,
   "reconocidas": "87 % de letras"
  },
  {
   "id": "primero",
   "text": "Primero: en anuncios de dropshipping ganas o pierdes según el creativo, el ángulo y la conversión; si el anuncio no conecta, el tráfico se va en seco.",
   "start": 7.09,
   "end": 14.79,
   "words": 27,
   "reconocidas": "95 % de letras"
  },
  {
   "id": "segundo",
   "text": "Segundo: en trading ganas o pierdes según lectura de mercado, gestión de riesgo y disciplina; un mal lote o una emoción te borra la cuenta.",
   "start": 14.87,
   "end": 21.83,
   "words": 25,
   "reconocidas": "96 % de letras"
  },
  {
   "id": "tercero",
   "text": "Tercero: en ads necesitas validar producto y oferta; en trading necesitas reglas estrictas y paciencia en pantalla.",
   "start": 21.91,
   "end": 27.62,
   "words": 17,
   "reconocidas": "95 % de letras"
  },
  {
   "id": "error",
   "text": "El error de casi todos es saltar al que ve más fácil y meter dinero sin medir cuánto puede perder.",
   "start": 27.7,
   "end": 32.05,
   "words": 20,
   "reconocidas": "100 % de letras"
  },
  {
   "id": "cierre",
   "text": "Guarda este video si estás decidiendo tu próximo paso y comenta DIFERENCIA para desglosar cuál encaja mejor contigo.",
   "start": 32.13,
   "end": 37.48,
   "words": 18,
   "reconocidas": "96 % de letras"
  }
 ],
